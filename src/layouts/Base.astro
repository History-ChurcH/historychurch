---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import { href } from '../lib/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = `${site.denomination} ${site.name} — ${site.tagline}`, image } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 링크 미리보기 기본 배너 — 원본은 design/og-banner.html
// 카카오톡은 주소별로 미리보기를 한동안 저장합니다. 바꾼 배너를 바로 보려면 https://developers.kakao.com/tool/debugger/sharing 에서 주소를 넣고 캐시를 지웁니다.
const DEFAULT_OG = '/images/og-banner.jpg';
const ogImage = new URL(image?.startsWith('http') ? image : href(image ?? DEFAULT_OG), Astro.site);
// GitHub Pages 미리보기 주소는 검색엔진에 노출하지 않습니다 (실제 도메인 연결 후 자동으로 풀립니다).
const noindex = Astro.site?.hostname.endsWith('github.io');
const brandFont = `https://fonts.googleapis.com/css2?family=Black+Han+Sans&text=${encodeURIComponent('히스토리교회')}&display=swap`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#182a25" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600;700&display=swap" />
    <link rel="stylesheet" href={brandFont} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Church',
        name: site.name,
        alternateName: site.nameEn,
        description: site.tagline,
        url: Astro.site,
        telephone: site.phone,
        email: site.email,
        address: { '@type': 'PostalAddress', streetAddress: site.address, addressCountry: 'KR' },
      })}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">본문 바로가기</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // 스크롤하면 .reveal 요소를 부드럽게 보여 줍니다.
      // 다시 위로 올라가 요소가 화면 아래로 빠지면 원래대로 돌려 두어, 내려올 때마다 다시 나타나게 합니다.
      // (위쪽으로 지나간 요소는 그대로 두어서, 위로 스크롤할 때 깜빡이지 않게 합니다)
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) entry.target.classList.add('is-in');
            else if (entry.boundingClientRect.top > 0) entry.target.classList.remove('is-in');
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
