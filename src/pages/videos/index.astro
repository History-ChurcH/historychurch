---
// 영상 — 설교 외의 영상(찬양, 행사, 간증 등). src/content/videos 에 유튜브 주소만 적은 글을 올리면 생깁니다.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CrossMark from '../../components/CrossMark.astro';
import site from '../../data/site.json';
import { byDateDesc, dot, href, ytThumb } from '../../lib/utils';

const videos = (await getCollection('videos')).sort(byDateDesc);
---

<Base title="영상" description={`${site.name} 찬양 · 행사 · 간증 영상`}>
  <PageHero label="영상 · Videos" title="영상으로 보는<br />히스토리교회" lead="찬양과 행사, 간증처럼 교회의 이야기를 영상으로 나눕니다. 예배 설교는 설교 페이지에 있습니다.">
    <div class="btn-row hero-actions">
      <a class="btn btn--light" href={href('/sermons/')}>설교 영상 보기<span class="btn__icon"><CrossMark class="" /></span></a>
      <a class="btn btn--ghost" href={site.links.youtube} target="_blank" rel="noopener">유튜브 채널<span class="btn__icon"><CrossMark class="" /></span></a>
    </div>
  </PageHero>

  <section class="section paper">
    <div class="container" data-filter-list data-page="12">
      {videos.length === 0 && <p class="empty muted">아직 올라온 영상이 없습니다. 설교 영상은 <a href={href('/sermons/')}>설교 페이지</a>에서 보실 수 있습니다.</p>}

      <div class="video-grid">
        {
          videos.map((v) => (
            <a class="video-card" href={href(`/videos/${v.id}/`)} data-category="영상">
              <div class="media ratio-16x9">
                <img src={ytThumb(v.data.youtube, 'hqdefault')} alt="" loading="lazy" decoding="async" width="480" height="360" />
                <span class="video-card__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M8 5.5v13l11-6.5z" /></svg>
                </span>
              </div>
              <p class="num muted video-card__date">{dot(v.data.date)}</p>
              <h3 class="video-card__title">{v.data.title}</h3>
            </a>
          ))
        }
      </div>

      <div class="more-wrap">
        <button type="button" class="btn btn--ghost" data-more>더 보기<span class="btn__icon"><CrossMark class="" /></span></button>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-actions {
    margin-top: 36px;
  }

  .empty {
    padding: 48px 0;
    text-align: center;
  }

  .empty a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(36px, 4vw, 56px) clamp(20px, 2.4vw, 32px);
  }

  @media (max-width: 960px) {
    .video-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .video-grid {
      grid-template-columns: 1fr;
    }
  }

  .video-card {
    display: block;
  }

  .video-card .media {
    position: relative;
  }

  .video-card__play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    margin: -27px 0 0 -27px;
    border-radius: 999px;
    background: rgba(19, 33, 29, 0.72);
    color: var(--on-dark);
    transition: background-color 0.3s;
  }

  .video-card:hover .video-card__play {
    background: var(--gold);
    color: var(--green-950);
  }

  .video-card__date {
    margin-top: 16px;
    font-size: 0.88rem;
  }

  .video-card__title {
    margin-top: 4px;
    font-size: 1.2rem;
    font-weight: 650;
    line-height: 1.4;
    letter-spacing: -0.03em;
    transition: color 0.3s;
  }

  .video-card:hover .video-card__title {
    color: var(--green-600);
  }
</style>

<script>
  import { setupFilterList } from '../../lib/filter-list';
  document.querySelectorAll<HTMLElement>('[data-filter-list]').forEach(setupFilterList);
</script>
