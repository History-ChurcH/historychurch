---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import CrossMark from '../../../components/CrossMark.astro';
import { byDateDesc, excerpt, href, longDate } from '../../../lib/utils';

type Kind = 'bulletins' | 'columns' | 'notices' | 'grace';
type Entry = CollectionEntry<Kind>;
const LABEL: Record<Kind, string> = { bulletins: '주보', columns: '목회서신', notices: '공지', grace: '은혜나눔' };

export async function getStaticPaths() {
  const kinds: Kind[] = ['bulletins', 'columns', 'notices', 'grace'];
  const paths = [];
  for (const kind of kinds) {
    const list = ((await getCollection(kind)) as Entry[]).sort(byDateDesc);
    for (const [i, entry] of list.entries()) {
      paths.push({ params: { kind, id: entry.id }, props: { kind, entry, newer: list[i - 1], older: list[i + 1] } });
    }
  }
  return paths;
}

interface Props {
  kind: Kind;
  entry: Entry;
  newer?: Entry;
  older?: Entry;
}

const { kind, entry, newer, older } = Astro.props;
const { Content } = await render(entry);
const data = entry.data as Record<string, any>;
const images: string[] = data.images ?? [];
const cover: string = data.cover ?? '';
const file: string = data.file ?? '';
const isColumn = kind === 'columns';
---

<Base title={entry.data.title} description={excerpt(entry.body, 140) || `${LABEL[kind]} · ${entry.data.title}`}>
  <section class="post-hero dark">
    <div class="container narrow">
      <a class="back" href={href(`/news/#${encodeURIComponent(LABEL[kind])}`)}>← {LABEL[kind]} 목록</a>
      <p class="label"><CrossMark /> {LABEL[kind]}</p>
      <h1 class="h1 post-hero__title">{entry.data.title}</h1>
      <p class="muted">
        {longDate(entry.data.date)}
        {(isColumn || kind === 'grace') && data.author && ` · ${data.author}`}
      </p>
    </div>
  </section>

  <article class="section paper">
    <div class="container narrow">
      {
        cover && (
          <figure class="post-cover">
            <img src={href(cover)} alt="" />
          </figure>
        )
      }

      <div class:list={['prose', { 'prose--serif': isColumn }]}>
        <Content />
      </div>

      {
        images.length > 0 && (
          <div class="post-images">
            {images.map((src, i) => (
              <a href={href(src)} target="_blank" rel="noopener" aria-label={`${i + 1}번째 이미지 크게 보기`}>
                <img src={href(src)} alt={`${entry.data.title} ${i + 1}`} loading={i ? 'lazy' : 'eager'} />
              </a>
            ))}
          </div>
        )
      }

      {
        file && (
          <p class="post-file">
            <a class="btn btn--gold" href={href(file)} target="_blank" rel="noopener">
              첨부파일 내려받기
              <span class="btn__icon">
                <CrossMark class="" />
              </span>
            </a>
          </p>
        )
      }

      <nav class="pager" aria-label={`다른 ${LABEL[kind]}`}>
        {
          newer ? (
            <a href={href(`/news/${kind}/${newer.id}/`)}>
              <span class="muted">← 최근 글</span>
              <strong>{newer.data.title}</strong>
            </a>
          ) : (
            <span />
          )
        }
        {
          older && (
            <a href={href(`/news/${kind}/${older.id}/`)} class="pager__older">
              <span class="muted">이전 글 →</span>
              <strong>{older.data.title}</strong>
            </a>
          )
        }
      </nav>
    </div>
  </article>
</Base>

<style>
  .post-hero {
    padding-top: calc(var(--header-h) + clamp(48px, 7vw, 100px));
    padding-bottom: clamp(40px, 5vw, 72px);
  }

  .back {
    display: inline-block;
    margin-bottom: 36px;
    color: var(--on-dark-2);
    font-size: 0.93rem;
  }

  .back:hover {
    color: var(--gold-soft);
  }

  .post-hero .label {
    margin-bottom: 18px;
  }

  .post-hero__title {
    font-size: clamp(1.9rem, 4.2vw, 3.4rem);
    margin-bottom: 16px;
  }

  .post-cover {
    margin-bottom: 48px;
  }

  .post-cover img {
    width: 100%;
    max-height: 70vh;
    object-fit: contain;
    border-radius: var(--radius);
    background: var(--cream);
  }

  .post-images {
    display: grid;
    gap: 16px;
    margin-top: 32px;
  }

  .post-images img {
    width: 100%;
    border-radius: 14px;
    box-shadow: 0 0 0 1px var(--line);
  }

  .post-file {
    margin-top: 32px;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 72px;
    padding-top: 28px;
    border-top: 1px solid var(--line-strong);
  }

  .pager a {
    display: grid;
    gap: 4px;
    font-size: 0.95rem;
  }

  .pager a:hover strong {
    color: var(--green-600);
  }

  .pager__older {
    text-align: right;
  }
</style>
