---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import CrossMark from '../../../components/CrossMark.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { byDateDesc, excerpt, href, longDate } from '../../../lib/utils';

type Kind = 'bulletins' | 'columns' | 'notices' | 'grace' | 'posts';
type Entry = CollectionEntry<Kind>;
const LABEL: Record<Kind, string> = { bulletins: '주보', columns: '목회서신', notices: '공지', grace: '은혜나눔', posts: '게시판' };
/** ‘목록’ 으로 돌아가는 주소. 은혜나눔은 게시판 안의 한 갈래입니다. */
const LIST: Record<Kind, string> = {
  bulletins: '/news/bulletins/',
  columns: '/news/columns/',
  notices: '/news/notices/',
  grace: `/news/posts/#${encodeURIComponent('은혜나눔')}`,
  posts: '/news/posts/',
};

export async function getStaticPaths() {
  const kinds: Kind[] = ['bulletins', 'columns', 'notices', 'grace', 'posts'];
  const paths = [];
  for (const kind of kinds) {
    const list = ((await getCollection(kind)) as Entry[]).sort(byDateDesc);
    for (const [i, entry] of list.entries()) {
      paths.push({ params: { kind, id: entry.id }, props: { kind, entry, newer: list[i - 1], older: list[i + 1] } });
    }
  }
  return paths;
}

interface Props {
  kind: Kind;
  entry: Entry;
  newer?: Entry;
  older?: Entry;
}

const { kind, entry, newer, older } = Astro.props;
const { Content } = await render(entry);
const data = entry.data as Record<string, any>;
const images: string[] = data.images ?? [];
const cover: string = data.cover ?? '';
const file: string = data.file ?? '';
const isColumn = kind === 'columns';
const isPdf = /\.pdf$/i.test(file);
const label = kind === 'posts' && data.category ? data.category : LABEL[kind];
const zoomList = JSON.stringify(images.map((src) => href(src)));
---

<Base title={entry.data.title} description={excerpt(entry.body, 140) || `${LABEL[kind]} · ${entry.data.title}`}>
  <section class="post-hero dark">
    <div class="container narrow">
      <a class="back" href={href(LIST[kind])}>← {kind === 'grace' ? '게시판' : LABEL[kind]} 목록</a>
      <p class="label"><CrossMark /> {label}</p>
      <h1 class="h1 post-hero__title">{entry.data.title}</h1>
      <p class="muted">
        {longDate(entry.data.date)}
        {data.author && ` · ${data.author}`}
      </p>
    </div>
  </section>

  <article class="section paper">
    <div class="container narrow">
      {
        cover && (
          <figure class="post-cover">
            <img src={href(cover)} alt="" />
          </figure>
        )
      }

      <div class:list={['prose', { 'prose--serif': isColumn }]}>
        <Content />
      </div>

      {
        images.length > 0 && (
          <div class="post-images">
            {images.map((src, i) => (
              <a href={href(src)} data-zoom={zoomList} data-zoom-start={i} data-zoom-title={entry.data.title} aria-label={`${i + 1}번째 이미지 크게 보기`}>
                <img src={href(src)} alt={`${entry.data.title} ${i + 1}`} loading={i ? 'lazy' : 'eager'} />
              </a>
            ))}
          </div>
        )
      }

      {
        isPdf && (
          <object class="post-pdf" data={href(file)} type="application/pdf" aria-label={`${entry.data.title} PDF`}>
            <p class="muted">이 브라우저에서는 PDF 를 바로 보여 줄 수 없습니다. 아래 단추를 눌러 열어 주세요.</p>
          </object>
        )
      }

      {
        file && (
          <p class="post-file btn-row">
            {isPdf && (
              <a class="btn btn--gold" href={href(file)} target="_blank" rel="noopener">
                PDF 크게 보기
                <span class="btn__icon">
                  <CrossMark class="" />
                </span>
              </a>
            )}
            <a class:list={['btn', isPdf ? 'btn--ghost' : 'btn--gold']} href={href(file)} download>
              {isPdf ? '내려받기' : '첨부파일 내려받기'}
              <span class="btn__icon">
                <CrossMark class="" />
              </span>
            </a>
          </p>
        )
      }

      <nav class="pager" aria-label={`다른 ${LABEL[kind]}`}>
        {
          newer ? (
            <a href={href(`/news/${kind}/${newer.id}/`)}>
              <span class="muted">← 최근 글</span>
              <strong>{newer.data.title}</strong>
            </a>
          ) : (
            <span />
          )
        }
        {
          older && (
            <a href={href(`/news/${kind}/${older.id}/`)} class="pager__older">
              <span class="muted">이전 글 →</span>
              <strong>{older.data.title}</strong>
            </a>
          )
        }
      </nav>
    </div>
  </article>

  {images.length > 0 && <Lightbox />}
</Base>

<style>
  .post-hero {
    padding-top: calc(var(--header-h) + clamp(48px, 7vw, 100px));
    padding-bottom: clamp(40px, 5vw, 72px);
  }

  .back {
    display: table; /* 뒤따르는 갈래 표시(label)와 한 줄에 붙지 않도록 */
    margin-bottom: 36px;
    color: var(--on-dark-2);
    font-size: 0.93rem;
  }

  .back:hover {
    color: var(--gold-soft);
  }

  .post-hero .label {
    margin-bottom: 18px;
  }

  .post-hero__title {
    font-size: clamp(1.9rem, 4.2vw, 3.4rem);
    margin-bottom: 16px;
  }

  .post-cover {
    margin-bottom: 48px;
  }

  .post-cover img {
    width: 100%;
    max-height: 70vh;
    object-fit: contain;
    border-radius: var(--radius);
    background: var(--cream);
  }

  .post-images {
    display: grid;
    gap: 16px;
    margin-top: 32px;
  }

  .post-images a {
    cursor: zoom-in;
  }

  .post-images img {
    width: 100%;
    border-radius: 14px;
    box-shadow: 0 0 0 1px var(--line);
  }

  .post-pdf {
    display: block;
    width: 100%;
    height: min(80vh, 1100px);
    margin-top: 32px;
    border-radius: 14px;
    box-shadow: 0 0 0 1px var(--line);
    background: var(--cream);
  }

  .post-pdf p {
    padding: 24px;
  }

  /* 휴대폰 브라우저는 PDF 를 첫 장만 보여 주는 경우가 많아, 단추로 여는 쪽이 낫습니다 */
  @media (max-width: 760px) {
    .post-pdf {
      display: none;
    }
  }

  .post-file {
    margin-top: 32px;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 72px;
    padding-top: 28px;
    border-top: 1px solid var(--line-strong);
  }

  .pager a {
    display: grid;
    gap: 4px;
    font-size: 0.95rem;
  }

  .pager a:hover strong {
    color: var(--green-600);
  }

  .pager__older {
    text-align: right;
  }
</style>
