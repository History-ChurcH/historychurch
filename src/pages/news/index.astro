---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CrossMark from '../../components/CrossMark.astro';
import PostList, { type PostItem } from '../../components/PostList.astro';
import { dot, excerpt, href } from '../../lib/utils';

/** 탭 이름. 은혜나눔과 일반 게시물은 ‘게시판’ 탭에 함께 모입니다. */
const TABS = ['주보', '목회서신', '공지', '게시판'];

const [bulletins, columns, notices, grace, posts] = await Promise.all([
  getCollection('bulletins'),
  getCollection('columns'),
  getCollection('notices'),
  getCollection('grace'),
  getCollection('posts'),
]);

const items = [
  ...bulletins.map((e) => ({ kind: 'bulletins', tab: '주보', tag: '주보', id: e.id, title: e.data.title, date: e.data.date, text: '', thumb: e.data.images[0] ?? '', pinned: false })),
  ...columns.map((e) => ({ kind: 'columns', tab: '목회서신', tag: '목회서신', id: e.id, title: e.data.title, date: e.data.date, text: excerpt(e.body, 120), thumb: e.data.cover, pinned: false })),
  ...notices.map((e) => ({ kind: 'notices', tab: '공지', tag: '공지', id: e.id, title: e.data.title, date: e.data.date, text: excerpt(e.body, 120), thumb: e.data.images[0] ?? '', pinned: e.data.pinned })),
  ...grace.map((e) => ({ kind: 'grace', tab: '게시판', tag: '은혜나눔', id: e.id, title: e.data.title, date: e.data.date, text: excerpt(e.body, 120), thumb: e.data.images[0] ?? '', pinned: false })),
  ...posts.map((e) => ({ kind: 'posts', tab: '게시판', tag: e.data.category || '게시판', id: e.id, title: e.data.title, date: e.data.date, text: excerpt(e.body, 120), thumb: e.data.images[0] ?? '', pinned: false })),
].sort((a, b) => b.date.getTime() - a.date.getTime() || b.id.localeCompare(a.id, 'en', { numeric: true }));

const rows: PostItem[] = items.map((i) => ({ href: href(`/news/${i.kind}/${i.id}/`), date: i.date, tag: i.tag, category: i.tab, title: i.title, text: i.text, thumb: i.thumb }));
const pinned = items.filter((i) => i.pinned);
---

<Base title="교회 소식" description="히스토리교회 주보, 목회서신, 공지사항, 게시판">
  <PageHero label="교회 소식 · News" title="이번 주 히스토리교회" lead="매주 주보와 담임목사님의 목회서신, 교회의 소식과 성도들의 나눔을 한곳에서 확인하세요." />

  <section class="section paper">
    <div class="container" data-filter-list data-page="15">
      {
        pinned.length > 0 && (
          <ul role="list" class="pinned">
            {pinned.map((i) => (
              <li>
                <a href={href(`/news/${i.kind}/${i.id}/`)}>
                  <span class="tag">📌 공지</span>
                  <strong>{i.title}</strong>
                  <span class="num muted">{dot(i.date)}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <div class="tabs" role="group" aria-label="소식 종류">
        <button type="button" aria-pressed="true" data-filter="all">전체</button>
        {TABS.map((label) => <button type="button" aria-pressed="false" data-filter={label}>{label}</button>)}
      </div>

      <PostList items={rows} />

      <div class="more-wrap">
        <button type="button" class="btn btn--ghost" data-more>더 보기<span class="btn__icon"><CrossMark class="" /></span></button>
      </div>
    </div>
  </section>
</Base>

<style>
  .pinned {
    display: grid;
    gap: 8px;
    margin-bottom: 40px;
  }

  .pinned a {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    padding: 18px 22px;
    border-radius: 14px;
    background: var(--cream);
  }

  .pinned strong {
    flex: 1;
    min-width: 12em;
  }

</style>

<script>
  import { setupFilterList } from '../../lib/filter-list';
  document.querySelectorAll<HTMLElement>('[data-filter-list]').forEach(setupFilterList);
</script>
