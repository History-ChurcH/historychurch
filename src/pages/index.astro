---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CrossMark from '../components/CrossMark.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import Logo from '../components/Logo.astro';
import site from '../data/site.json';
import about from '../data/about.json';
import { byDateDesc, dot, excerpt, href, longDate, ytThumb } from '../lib/utils';

const sermons = (await getCollection('sermons')).sort(byDateDesc);
const sunday = sermons.find((s) => s.data.category === '주일예배') ?? sermons[0];
const weekday = ['수요예배', '금요기도회']
  .map((c) => sermons.find((s) => s.data.category === c))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

const bulletin = (await getCollection('bulletins')).sort(byDateDesc)[0];
const columns = (await getCollection('columns')).sort(byDateDesc).slice(0, 3);
// 홈 화면 공지: 고정한 공지 + 최근 30일 안의 공지만, 최대 3개. 하나도 없으면 공지 칸을 숨깁니다.
// (사이트는 새 글·설교가 올라올 때마다 다시 만들어지므로, 30일이 지난 공지는 그때 빠집니다)
const NOTICE_DAYS = 30;
const noticeSince = Date.now() - NOTICE_DAYS * 24 * 60 * 60 * 1000;
const notices = (await getCollection('notices'))
  .filter((n) => n.data.pinned || n.data.date.getTime() >= noticeSince)
  .sort((a, b) => Number(b.data.pinned) - Number(a.data.pinned) || byDateDesc(a, b))
  .slice(0, 3);
const noticeKey = notices.map((n) => n.id).join(',');
const albums = (await getCollection('albums')).sort(byDateDesc).slice(0, 8);

// 소개 글에서 ‘따옴표’로 감싼 말을 강조합니다.
const emphasize = (text: string) => text.replace(/‘([^’]+)’/g, '<em>‘$1’</em>');
const passagePreview = sunday?.data.passage.split('\n').slice(0, 2).join('\n');
---

<Base>
  <!-- 1. 첫 화면 -->
  <section class="hero dark">
    <div class="hero__light" aria-hidden="true">
      <span class="hero__beam hero__beam--v"></span>
      <span class="hero__beam hero__beam--h"></span>
      <span class="hero__glow"></span>
    </div>

    <div class="container hero__inner">
      <p class="label hero__label"><CrossMark /> {site.denomination} · Since {site.founded}</p>
      <h1 class="display hero__title">
        <span class="hero__line">말씀의 <em>역사</em>로</span>
        <span class="hero__line">믿음의 <em>역사</em>를</span>
        <span class="hero__line">쓰는 교회</span>
      </h1>

      <div class="hero__bottom">
        <p class="hero__welcome">
          환영합니다.<br />
          히스토리교회는 성남시 분당구에서 말씀과 성령의 역사를 함께 경험하는 {site.denomination} 교회입니다.
        </p>

        {
          sunday && (
            <a class="hero-sermon" href="#this-week">
              <span class="hero-sermon__thumb">
                <img src={ytThumb(sunday.data.youtube, 'mqdefault')} alt="" width="320" height="180" />
                <span class="hero-sermon__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M8 5.5v13l11-6.5z" /></svg>
                </span>
              </span>
              <span class="hero-sermon__text">
                <span class="hero-sermon__label">이번 주 설교 · {dot(sunday.data.date)}</span>
                <span class="hero-sermon__title">{sunday.data.title}</span>
                <span class="hero-sermon__meta">{[sunday.data.scripture, sunday.data.preacher].filter(Boolean).join(' · ')}</span>
              </span>
            </a>
          )
        }
      </div>
    </div>

    <a class="hero__scroll" href="#this-week" aria-label="이번 주 설교로 이동">
      <CrossMark class="" />
    </a>
  </section>

  <!-- 2. 이번 주 설교 -->
  {
    sunday && (
      <section id="this-week" class="section sermon darker">
        <div class="container">
          <div class="sermon__grid">
            <div class="sermon__video reveal">
              <VideoPlayer id={sunday.data.youtube} title={sunday.data.title} />
            </div>

            <div class="sermon__info reveal" style="--delay:.1s">
              <p class="label">
                <CrossMark /> 이번 주 설교 · This Sunday
              </p>
              <p class="sermon__date muted">{longDate(sunday.data.date)}</p>
              <h2 class="h1 sermon__title">{sunday.data.title}</h2>

              <dl class="sermon__meta">
                {sunday.data.scripture && (
                  <div>
                    <dt>본문</dt>
                    <dd>{sunday.data.scripture}</dd>
                  </div>
                )}
                <div>
                  <dt>설교</dt>
                  <dd>{sunday.data.preacher}</dd>
                </div>
                {sunday.data.series && (
                  <div>
                    <dt>시리즈</dt>
                    <dd>{sunday.data.series}</dd>
                  </div>
                )}
              </dl>

              {passagePreview && <p class="sermon__passage serif">{passagePreview}…</p>}

              <div class="btn-row">
                <a class="btn btn--light" href={href(`/sermons/${sunday.id}/`)}>
                  설교 본문과 함께 보기
                  <span class="btn__icon">
                    <CrossMark class="" />
                  </span>
                </a>
                <a class="btn btn--ghost" href={href('/sermons/')}>
                  지난 설교
                  <span class="btn__icon">
                    <CrossMark class="" />
                  </span>
                </a>
              </div>
            </div>
          </div>

          {weekday.length > 0 && (
            <div class="sermon__others">
              <p class="sermon__others-title">이번 주 다른 예배</p>
              <div class="sermon__others-list">
                {weekday.map((s) => (
                  <a class="mini-sermon" href={href(`/sermons/${s.id}/`)}>
                    <span class="media ratio-16x9">
                      <img src={ytThumb(s.data.youtube, 'mqdefault')} alt="" loading="lazy" width="320" height="180" />
                    </span>
                    <span>
                      <span class="tag">{s.data.category}</span>
                      <span class="mini-sermon__title">{s.data.title}</span>
                      <span class="mini-sermon__meta muted">
                        {dot(s.data.date)}
                        {s.data.scripture && ` · ${s.data.scripture}`}
                      </span>
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- 3. 우리는 이런 교회입니다 -->
  <section class="section cream intro">
    <div class="container">
      <p class="label"><CrossMark /> 히스토리교회는</p>
      <p class="statement intro__statement reveal" set:html={emphasize(about.intro)} />

      <ul role="list" class="facts reveal">
        <li><strong class="num">{site.founded}</strong><span>코로나 시대에 세워진 교회</span></li>
        <li><strong>감리교</strong><span>{site.denomination} 소속</span></li>
        <li><strong>분당</strong><span>매화로 40, 동륜빌딩 5층</span></li>
      </ul>

      <ol role="list" class="visions">
        {
          about.visions.map((v, i) => (
            <li class="vision reveal" style={`--delay:${i * 0.08}s`}>
              <span class="vision__num num">0{i + 1}</span>
              <h3 class="h3">{v.title}</h3>
              <p class="muted">{v.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="pastor reveal">
        <img class="pastor__photo" src={href(about.pastor.photo)} alt={`${about.pastor.name} ${about.pastor.title}`} width="413" height="531" loading="lazy" />
        <div>
          <p class="pastor__quote serif">“우리의 가능성이 하나님의 능력과 만나고, 우리의 기도가 하나님의 뜻으로 발견될 때, 우리의 삶은 하나님의 흔적으로 가득 찰 것입니다.”</p>
          <p class="pastor__name">{about.pastor.title} <strong>{about.pastor.name}</strong></p>
          <a class="text-link" href={href('/about/#greeting')}>인사말 전문 보기 →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. 올해의 표어 -->
  <section class="motto dark">
    <div class="container motto__inner reveal">
      <p class="label"><CrossMark /> {site.motto.year} 표어</p>
      <p class="motto__text serif">{site.motto.text}</p>
      <p class="motto__verse">{site.motto.full} <span>({site.motto.verse})</span></p>
    </div>
  </section>

  <!-- 5. 예배 안내 -->
  <section class="section paper" id="worship">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="label"><CrossMark /> 예배 안내</p>
          <h2 class="h2">처음이어도 괜찮아요.<br />편하게 오세요.</h2>
        </div>
        <a class="text-link" href={href('/worship/')}>예배 · 오시는 길 자세히 →</a>
      </div>

      <div class="worship">
        <ul role="list" class="services">
          {
            site.services.map((s) => (
              <li class="services__row reveal">
                <span class="services__name">{s.name}</span>
                <span class="services__time num">{s.time}</span>
                <span class="services__place muted">{s.place}</span>
              </li>
            ))
          }
        </ul>

        <div class="visit-card dark reveal">
          <p class="label"><CrossMark /> 오시는 길</p>
          <p class="visit-card__address">{site.address}</p>
          <p class="muted">히스토리교회</p>
          <div class="btn-row">
            <a class="btn btn--sm btn--gold" href={site.links.naverMap} target="_blank" rel="noopener">네이버 지도<span class="btn__icon"><CrossMark class="" /></span></a>
            <a class="btn btn--sm btn--ghost" href={site.links.kakaoMap} target="_blank" rel="noopener">카카오맵<span class="btn__icon"><CrossMark class="" /></span></a>
          </div>
          <p class="visit-card__contact">문의 <a href={`tel:${site.phone}`} class="num">{site.phone}</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. 교회 소식 -->
  <section class="section cream">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="label"><CrossMark /> 교회 소식</p>
          <h2 class="h2">이번 주 히스토리교회</h2>
        </div>
        <a class="text-link" href={href('/news/')}>소식 전체 보기 →</a>
      </div>

      <div class:list={['news', { 'news--two': notices.length === 0 }]}>
        {
          bulletin && (
            <a class="news__bulletin reveal" href={href(`/news/bulletins/${bulletin.id}/`)}>
              <span class="news__kind">주보</span>
              {bulletin.data.images[0] && (
                <span class="media news__bulletin-img">
                  <img src={href(bulletin.data.images[0])} alt="" loading="lazy" />
                </span>
              )}
              <span class="news__title">{bulletin.data.title}</span>
              <span class="news__date num muted">{dot(bulletin.data.date)}</span>
            </a>
          )
        }

        <div class="news__col reveal" style="--delay:.08s">
          <p class="news__kind">목회서신</p>
          <ul role="list">
            {
              columns.map((c) => (
                <li>
                  <a class="news__item" href={href(`/news/columns/${c.id}/`)}>
                    <span class="news__date num muted">{dot(c.data.date)}</span>
                    <span class="news__title">{c.data.title}</span>
                    <span class="news__excerpt muted">{excerpt(c.body, 70)}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        {
          notices.length > 0 && (
            <details class="news__col news__notices reveal" style="--delay:.16s" open data-notice-fold={noticeKey}>
              <summary class="news__kind">
                공지
                <span class="news__fold" aria-hidden="true" />
                <span class="sr-only">접기/펼치기</span>
              </summary>
              <ul role="list">
                {notices.map((n) => (
                  <li>
                    <a class="news__item" href={href(`/news/notices/${n.id}/`)}>
                      <span class="news__date num muted">
                        {n.data.pinned && '📌 '}
                        {dot(n.data.date)}
                      </span>
                      <span class="news__title">{n.data.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
              <a class="text-link news__more" href={href('/news/notices/')}>
                공지 전체 보기 →
              </a>
            </details>
          )
        }
      </div>
    </div>
  </section>

  <!-- 7. 앨범 -->
  {
    albums.length > 0 && (
      <section class="section paper albums-home">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="label">
                <CrossMark /> 교회 앨범
              </p>
              <h2 class="h2">함께한 시간들</h2>
            </div>
            <a class="text-link" href={href('/album/')}>
              앨범 전체 보기 →
            </a>
          </div>
        </div>
        <div class="albums-home__track" tabindex="0" aria-label="최근 앨범">
          {albums.map((a) => (
            <a class="album-tile" href={href(`/album/${a.id}/`)}>
              <span class="media ratio-4x3">
                <img src={href(a.data.cover || a.data.photos[0])} alt="" loading="lazy" />
              </span>
              <span class="album-tile__title">{a.data.title}</span>
              <span class="album-tile__meta muted">
                {dot(a.data.date)} · 사진 {a.data.photos.length}장
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- 8. 초대 -->
  <section class="section invite dark">
    <Logo tone="light" wordmark={false} class="invite__mark" />
    <div class="container invite__inner">
      <p class="label"><CrossMark /> Welcome</p>
      <p class="display invite__title reveal">이 ‘믿음의 역사’에<br />당신을 초대합니다.</p>
      <div class="btn-row reveal">
        <a class="btn btn--gold" href={href('/worship/')}>예배 안내<span class="btn__icon"><CrossMark class="" /></span></a>
        <a class="btn btn--ghost" href={href('/about/')}>교회 소개<span class="btn__icon"><CrossMark class="" /></span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- 1. 첫 화면 ---------- */
  .hero {
    position: relative;
    display: flex;
    min-height: 100svh;
    overflow: hidden;
    background:
      radial-gradient(120% 80% at 80% 0%, rgba(61, 95, 88, 0.55), transparent 60%),
      var(--green-900);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--header-h) + 64px);
    padding-bottom: clamp(40px, 7vw, 96px);
  }

  .hero__label {
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .hero__title em {
    font-style: normal;
    color: var(--gold-soft);
  }

  .hero__line {
    display: block;
    animation: rise 1.3s var(--ease) both;
  }

  .hero__line:nth-child(2) {
    animation-delay: 0.12s;
  }

  .hero__line:nth-child(3) {
    animation-delay: 0.24s;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }

  .hero__bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-top: clamp(48px, 7vw, 96px);
    padding-top: 28px;
    border-top: 1px solid var(--line-dark);
    animation: rise 1.3s 0.4s var(--ease) both;
  }

  .hero__welcome {
    max-width: 26em;
    color: var(--on-dark-2);
    font-size: 0.98rem;
  }

  .hero-sermon {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 10px 22px 10px 10px;
    border-radius: 18px;
    background: rgba(244, 240, 230, 0.06);
    box-shadow: inset 0 0 0 1px var(--line-dark);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    transition: background-color 0.4s var(--ease);
  }

  .hero-sermon:hover {
    background: rgba(244, 240, 230, 0.12);
  }

  .hero-sermon__thumb {
    position: relative;
    flex: none;
    width: 148px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 10px;
  }

  .hero-sermon__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-sermon__play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin: -17px 0 0 -17px;
    border-radius: 999px;
    background: var(--gold);
    color: var(--ink);
  }

  .hero-sermon__text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .hero-sermon__label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--gold-soft);
  }

  .hero-sermon__title {
    font-size: 1.12rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.35;
  }

  .hero-sermon__meta {
    font-size: 0.85rem;
    color: var(--on-dark-2);
  }

  /* 빛의 십자가 — 로고의 십자가에서 가져온 모티프 */
  .hero__light {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__beam {
    position: absolute;
    background: var(--gold);
    opacity: 0.55;
  }

  .hero__beam--v {
    left: 74%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(180deg, rgba(254, 183, 8, 0), rgba(254, 183, 8, 0.9) 34%, rgba(254, 183, 8, 0.35) 70%, rgba(254, 183, 8, 0));
    transform-origin: top;
    animation: beam-v 2.2s 0.2s var(--ease) both;
  }

  .hero__beam--h {
    left: 56%;
    right: 8%;
    top: 34%;
    height: 1px;
    background: linear-gradient(90deg, rgba(254, 183, 8, 0), rgba(254, 183, 8, 0.9) 50%, rgba(254, 183, 8, 0));
    animation: beam-h 2.2s 0.6s var(--ease) both;
  }

  .hero__glow {
    position: absolute;
    left: 74%;
    top: 34%;
    width: min(70vw, 820px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(254, 183, 8, 0.2), rgba(254, 183, 8, 0.06) 45%, rgba(254, 183, 8, 0) 72%);
    animation: breathe 7s ease-in-out infinite;
  }

  @keyframes beam-v {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes beam-h {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
  }

  @keyframes breathe {
    50% {
      opacity: 0.7;
      transform: translate(-50%, -50%) scale(0.94);
    }
  }

  .hero__scroll {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: 22px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: -22px;
    color: var(--gold-soft);
    animation: float 3s ease-in-out infinite;
  }

  .hero__scroll svg {
    width: 18px;
    height: 18px;
  }

  @keyframes float {
    50% {
      transform: translateY(6px);
    }
  }

  @media (max-width: 860px) {
    .hero__bottom {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__beam--v {
      left: 82%;
    }

    .hero__beam--h {
      left: 50%;
      right: 0;
      top: 26%;
    }

    .hero__glow {
      left: 82%;
      top: 26%;
    }

    .hero__scroll {
      display: none;
    }
  }

  /* ---------- 2. 이번 주 설교 ---------- */
  .sermon__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }

  .sermon__info .label {
    margin-bottom: 20px;
  }

  .sermon__date {
    font-size: 0.95rem;
  }

  .sermon__title {
    margin-top: 6px;
  }

  .sermon__meta {
    display: grid;
    gap: 8px;
    margin-top: 28px;
    padding-block: 20px;
    border-block: 1px solid var(--line-dark);
  }

  .sermon__meta div {
    display: flex;
    gap: 20px;
  }

  .sermon__meta dt {
    width: 3.5em;
    flex: none;
    color: var(--on-dark-2);
  }

  .sermon__passage {
    margin: 24px 0 32px;
    white-space: pre-line;
    color: var(--on-dark-2);
    font-size: 1rem;
    line-height: 1.9;
  }

  .sermon__others {
    margin-top: clamp(56px, 7vw, 96px);
    padding-top: 32px;
    border-top: 1px solid var(--line-dark);
  }

  .sermon__others-title {
    margin-bottom: 20px;
    color: var(--on-dark-2);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .sermon__others-list {
    display: grid;
