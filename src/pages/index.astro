<script>
  // 공지 칸을 접어 두면 이 기기에서는 접힌 채로 보입니다. 새 공지가 올라오면 다시 펼쳐집니다.
  const fold = document.querySelector<HTMLDetailsElement>('[data-notice-fold]');
  if (fold) {
    const KEY = 'home-notices-folded';
    try {
      if (localStorage.getItem(KEY) === fold.dataset.noticeFold) fold.open = false;
    } catch {}
    fold.addEventListener('toggle', () => {
      try {
        if (fold.open) localStorage.removeItem(KEY);
        else localStorage.setItem(KEY, fold.dataset.noticeFold || '');
      } catch {}
    });
  }
</script>
