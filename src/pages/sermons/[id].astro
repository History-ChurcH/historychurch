---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CrossMark from '../../components/CrossMark.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import SermonCard from '../../components/SermonCard.astro';
import { byDateDesc, href, longDate } from '../../lib/utils';

export async function getStaticPaths() {
  const sermons = (await getCollection('sermons')).sort(byDateDesc);
  return sermons.map((sermon, i) => ({
    params: { id: sermon.id },
    props: { sermon, newer: sermons[i - 1], older: sermons[i + 1], related: sermons.filter((s) => s.id !== sermon.id && s.data.category === sermon.data.category).slice(0, 3) },
  }));
}

const { sermon, newer, older, related } = Astro.props;
const { title, date, category, preacher, scripture, series, youtube, passage, summary } = sermon.data;
const { Content } = await render(sermon);
const hasBody = Boolean(sermon.body?.trim());
---

<Base title={title} description={[category, scripture, summary].filter(Boolean).join(' · ')}>
  <section class="sermon-hero darker">
    <div class="container sermon-hero__inner">
      <a class="back" href={href('/sermons/')}>← 설교 목록</a>
      <div class="sermon-hero__head">
        <span class="tag">{category}</span>
        <span class="muted">{longDate(date)}</span>
      </div>
      <h1 class="h1">{title}</h1>
      <p class="sermon-hero__meta muted">{[scripture, preacher, series].filter(Boolean).join(' · ')}</p>
      <div class="sermon-hero__video">
        <VideoPlayer id={youtube} title={title} eager />
      </div>
    </div>
  </section>

  <section class="section paper">
    <div class="container narrow">
      {summary && <p class="statement sermon-summary">{summary}</p>}

      {
        passage && (
          <div class="passage">
            <p class="label">
              <CrossMark /> 본문 말씀 {scripture && `· ${scripture}`}
            </p>
            <div class="passage__text serif">
              {passage.split('\n').map((line) => {
                const m = line.match(/^(\d+)\s+(.*)$/);
                return m ? (
                  <p>
                    <sup class="num">{m[1]}</sup>
                    {m[2]}
                  </p>
                ) : (
                  <p>{line}</p>
                );
              })}
            </div>
          </div>
        )
      }

      {
        hasBody && (
          <div class="prose sermon-notes">
            <Content />
          </div>
        )
      }

      <nav class="pager" aria-label="다른 설교">
        {
          newer ? (
            <a href={href(`/sermons/${newer.id}/`)}>
              <span class="muted">← 다음 설교</span>
              <strong>{newer.data.title}</strong>
            </a>
          ) : (
            <span />
          )
        }
        {
          older && (
            <a href={href(`/sermons/${older.id}/`)} class="pager__older">
              <span class="muted">이전 설교 →</span>
              <strong>{older.data.title}</strong>
            </a>
          )
        }
      </nav>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section--tight cream">
        <div class="container">
          <p class="label related-label">
            <CrossMark /> {category} 더 보기
          </p>
          <div class="related">
            {related.map((s) => (
              <SermonCard sermon={s} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .sermon-hero {
    padding-top: calc(var(--header-h) + clamp(40px, 6vw, 80px));
    padding-bottom: clamp(48px, 6vw, 80px);
  }

  .back {
    display: inline-block;
    margin-bottom: 32px;
    color: var(--on-dark-2);
    font-size: 0.93rem;
  }

  .back:hover {
    color: var(--gold-soft);
  }

  .sermon-hero__head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
    font-size: 0.93rem;
  }

  .sermon-hero__meta {
    margin-top: 16px;
  }

  .sermon-hero__video {
    max-width: 1100px;
    margin-top: clamp(32px, 4vw, 56px);
  }

  .sermon-summary {
    margin-bottom: 56px;
  }

  .passage .label {
    margin-bottom: 24px;
  }

  .passage__text {
    display: grid;
    gap: 10px;
    padding: clamp(28px, 4vw, 48px);
    border-radius: var(--radius);
    background: var(--cream);
    font-size: 1.08rem;
    line-height: 1.95;
  }

  .passage__text sup {
    margin-right: 8px;
    font-family: var(--sans);
    font-size: 0.72em;
    font-weight: 600;
    color: var(--green-600);
  }

  .sermon-notes {
    margin-top: 56px;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 72px;
    padding-top: 28px;
    border-top: 1px solid var(--line-strong);
  }

  .pager a {
    display: grid;
    gap: 4px;
    font-size: 0.95rem;
  }

  .pager a:hover strong {
    color: var(--green-600);
  }

  .pager__older {
    text-align: right;
  }

  .related-label {
    margin-bottom: 32px;
  }

  .related {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  @media (max-width: 860px) {
    .related {
      grid-template-columns: 1fr;
    }
  }
</style>
